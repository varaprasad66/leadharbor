{
  "name": "LeadHarbor - 03 Cadence Scheduler (15 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "sched-1",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.LEADHARBOR_API_URL}}/api/v1/cadence/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{$env.LEADHARBOR_API_KEY}}" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "http-cadence-1",
      "name": "Run Cadence Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "Run Cadence Engine", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "instanceId": "leadharbor" },
  "tags": ["leadharbor"]
}
