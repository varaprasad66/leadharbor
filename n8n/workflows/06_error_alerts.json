{
  "name": "LeadHarbor - 06 Error Alerts",
  "nodes": [
    {
      "parameters": {},
      "id": "err-trig-1",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':rotating_light: n8n workflow failed: ' + $json.workflow.name + ' (execution ' + $json.execution.id + ') — ' + ($json.execution.error ? $json.execution.error.message : 'see execution log') }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "http-slack-1",
      "name": "Alert Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "continueOnFail": true
    }
  ],
  "connections": {
    "On Workflow Error": {
      "main": [[{ "node": "Alert Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "instanceId": "leadharbor" },
  "tags": ["leadharbor"]
}
