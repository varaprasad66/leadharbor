# =============================================================================
# LeadHarbor configuration
# Copy to .env and fill in real values. Every field has a safe local default.
# Prefix for all vars: LEADHARBOR_
# =============================================================================

# --- Core ---
LEADHARBOR_ENVIRONMENT=development            # development | staging | production
LEADHARBOR_API_KEY=dev-key-change-me          # X-API-Key for internal + n8n endpoints
LEADHARBOR_DATABASE_URL=sqlite:///./leadharbor.db
LEADHARBOR_PUBLIC_BASE_URL=http://localhost:8000

# --- Brand voice ---
LEADHARBOR_COMPANY_NAME=Meridian Realty Dubai
LEADHARBOR_ADVISOR_NAME=Maya
LEADHARBOR_BOOKING_LINK=https://cal.com/leadharbor/intro

# --- Facebook / Instagram Lead Ads ---
LEADHARBOR_FACEBOOK_VERIFY_TOKEN=leadharbor-verify
LEADHARBOR_FACEBOOK_ACCESS_TOKEN=             # page/system-user token for Graph API lead fetch

# --- Twilio (SMS + WhatsApp) ---
LEADHARBOR_TWILIO_ACCOUNT_SID=
LEADHARBOR_TWILIO_AUTH_TOKEN=                 # empty = signature verification disabled (dev only)
LEADHARBOR_TWILIO_SMS_FROM=+15551234567       # A2P 10DLC-registered number
LEADHARBOR_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Email (SendGrid) ---
LEADHARBOR_SENDGRID_API_KEY=
LEADHARBOR_EMAIL_FROM=leads@yourdomain.com
LEADHARBOR_COMPANY_ADDRESS=Office 1204, Marina Plaza, Dubai Marina, Dubai, UAE   # CAN-SPAM footer

# --- LLM (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, vLLM...) ---
LEADHARBOR_LLM_PROVIDER=mock                  # mock | openai-compatible
LEADHARBOR_LLM_API_KEY=
LEADHARBOR_LLM_BASE_URL=https://api.openai.com/v1
LEADHARBOR_LLM_MODEL=gpt-4o-mini

# --- CRM: ghl | hubspot | none ---
LEADHARBOR_CRM_PROVIDER=none
LEADHARBOR_GHL_ACCESS_TOKEN=
LEADHARBOR_GHL_LOCATION_ID=
LEADHARBOR_HUBSPOT_ACCESS_TOKEN=

# --- Sales-team alerts: comma list of slack,whatsapp,email ---
LEADHARBOR_ALERT_CHANNELS=slack,whatsapp,email
LEADHARBOR_SLACK_WEBHOOK_URL=
LEADHARBOR_SALES_ALERT_WHATSAPP=whatsapp:+15559876543
LEADHARBOR_SALES_ALERT_EMAIL= sales@yourdomain.com

# --- Compliance ---
LEADHARBOR_QUIET_HOURS_START=21               # local hour at which quiet hours begin
LEADHARBOR_QUIET_HOURS_END=8                  # local hour at which sending resumes
LEADHARBOR_DEFAULT_CONSENT_WHEN_MISSING=false # NEVER set true in production
LEADHARBOR_DEDUPE_WINDOW_HOURS=72

# --- Follow-up cadence (optional JSON override; hours after previous touch) ---
# LEADHARBOR_CADENCE_STEPS_JSON=[{"step":1,"after_hours":1,"channel":"sms","template":"followup_sms_1"},{"step":2,"after_hours":24,"channel":"email","template":"followup_email_1"},{"step":3,"after_hours":72,"channel":"sms","template":"followup_sms_2"},{"step":4,"after_hours":168,"channel":"email","template":"followup_email_2"},{"step":5,"after_hours":336,"channel":"sms","template":"followup_sms_3"}]
LEADHARBOR_MAX_FOLLOWUPS=8

# --- Scoring rubric (optional JSON override; see docs/ASSUMPTIONS.md) ---
# LEADHARBOR_SCORING_RULES_JSON={"budget_bands":[{"min_usd":200000,"points":40},{"min_usd":100000,"max_usd":200000,"points":25},{"min_usd":50000,"max_usd":100000,"points":10},{"min_usd":0,"max_usd":50000,"points":5}],"timeline_points":{"0-3":30,"3-6":20,"6-12":10,"12+":5,"unknown":0},"readiness_points":{"meeting_requested":30,"call_requested":25,"pricing_question":15,"general":5},"engagement_points_per_reply":5,"engagement_points_max":15,"tier_thresholds":{"hot":70,"warm":40,"nurture":20}}
